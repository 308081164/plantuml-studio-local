{
  "name": "plantuml-studio-local",
  "version": "2.0.0-pro.14",
  "description": "本地 PlantUML 编辑预览（PicoWeb + Electron，v2.0.0 Pro：KB 分层注入、意图路由、规划器扩展与分级修正）",
  "main": "electron-main.mjs",
  "type": "module",
  "author": "",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "prepare:jre": "node scripts/download-jre.mjs",
    "pack": "electron-builder --dir",
    "dist": "npm run prepare:jre && electron-builder --win --x64",
    "dist:beta": "npm run prepare:jre && electron-builder --win --x64",
    "dist:portable": "npm run prepare:jre && electron-builder --win --x64 portable",
    "dist:nsis": "npm run prepare:jre && electron-builder --win --x64 nsis"
  },
  "build": {
    "appId": "com.uml_master.plantuml-studio",
    "productName": "PlantUML本地工作室",
    "publish": null,
    "directories": {
      "output": "releases"
    },
    "icon": "assets/app-logo-512.png",
    "files": [
      "electron-main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "scripts/app-menu.mjs",
      "scripts/license-common.mjs",
      "scripts/agent-session-lock.mjs",
      "scripts/project-index.mjs",
      "scripts/project-context.mjs",
      "scripts/agent-intent.mjs",
      "scripts/kb-inject.mjs",
      "scripts/diagram-grammar.mjs",
      "scripts/studio-arch-graph.mjs",
      "scripts/arch-agent-prompt.mjs",
      "assets/app-logo-512.png"
    ],
    "extraResources": [
      {
        "from": "vendor/plantuml",
        "to": "plantuml",
        "filter": [
          "plantuml-*.jar"
        ]
      },
      {
        "from": "vendor/jre",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/kb",
        "to": "kb",
        "filter": [
          "*.md"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlantUML本地工作室",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "mxgraph": "^4.2.2"
  }
}
