{
  "name": "plantuml-license-keygen-gui",
  "version": "1.0.0",
  "private": true,
  "description": "PlantUML 本地工作室 — 密钥生成器（激活码 + 月度密钥登记）",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.uml_master.plantuml-license-keygen",
    "productName": "PlantUML密钥生成器",
    "directories": {
      "output": "release"
    },
    "artifactName": "PlantUML密钥生成器-${version}-portable.${ext}",
    "files": [
      "electron-main.mjs",
      "preload.cjs",
      "renderer/**/*",
      {
        "from": "../scripts/license-common.mjs",
        "to": "license-common.mjs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
