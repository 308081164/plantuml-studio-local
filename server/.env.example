# ============================================================
# PlantUML 本地工作室 · 支付服务环境变量
# 使用：复制为与本文件同目录下的 .env（即 server/.env），再按需填写
#   cp .env.example .env
# 切勿将 .env 提交到 git
# ============================================================

# ------------------------------------------------------------
# 基础
# ------------------------------------------------------------
# 监听端口；留空则默认 8848
PORT=

# 1 或 true = 仅走模拟支付（/mock-pay）；留空或其它值 = 走真实支付宝（须配置 ALIPAY_*）
MOCK_PAY=

# ------------------------------------------------------------
# GitHub Actions「发布元数据」POST /internal/github-release
# 须与仓库 Secret STUDIO_RELEASE_INJECT_TOKEN 一致；不用该接口可留空
# ------------------------------------------------------------
STUDIO_RELEASE_INJECT_TOKEN=

# ------------------------------------------------------------
# 支付宝（MOCK_PAY 未开启时，下列三项一般均需填写）
# ------------------------------------------------------------
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 网关；留空则默认 https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=

# 在线 PlantUML 预览（/api/convert/plantuml）请求的 SVG 根地址；留空默认 https://www.plantuml.com/plantuml/svg
PLANTUML_ONLINE_SVG_BASE=

# ------------------------------------------------------------
# 网页端「自然语言 → PlantUML」（POST /api/convert/plantuml-nl）
# 与 DeepSeek 官方 OpenAI 兼容接口一致：POST {BASE}/v1/chat/completions
# 未配置 API Key 时该接口返回 503，页面仅保留「源码渲染」能力
# ------------------------------------------------------------
# 必填：填写后启用在线自然语言生成（请勿泄露；勿提交到 git）
STUDIO_ONLINE_DEEPSEEK_API_KEY=
# 可选：默认 https://api.deepseek.com；兼容其它 OpenAI 式网关时可改写
STUDIO_ONLINE_DEEPSEEK_BASE_URL=
# 可选：默认 deepseek-chat
STUDIO_ONLINE_DEEPSEEK_MODEL=

# 外网根地址（https://域名 或 https://域名:8848），用于 notify_url / return_url；留空则用请求 Host 推导（仅适合内网调试）
PUBLIC_BASE_URL=

# 私钥格式：PKCS1 或 PKCS8；留空则默认 PKCS8
ALIPAY_KEY_TYPE=

# ------------------------------------------------------------
# 其它可选
# ------------------------------------------------------------
# unlockToken 派生盐；留空则使用内置默认盐
UNLOCK_PEPPER=

# 订单等数据目录；留空则默认 server/data（Docker 内常为 /app/data）
STUDIO_SERVER_DATA_DIR=

# 置于 Nginx/反代后需识别 HTTPS 时填 1；留空则不启用
TRUST_PROXY=
