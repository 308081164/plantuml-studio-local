# 服务器环境（示例）
#
# 使用方式：复制本文件为「与 server/index.mjs 同目录」下的文件名 `.env` 后填写。
# 即仓库路径：server/.env（已被 .gitignore 忽略，勿提交）

PORT=8848
# 开发联调：模拟支付页，无需真实支付宝
MOCK_PAY=1

# GitHub Actions 调用 /internal/github-release 时的 Bearer 口令（与仓库 Secret STUDIO_RELEASE_INJECT_TOKEN 一致）
STUDIO_RELEASE_INJECT_TOKEN=

# 可选：unlockToken 派生盐
UNLOCK_PEPPER=

# —— 支付宝（正式环境）——
# 开放平台应用 APPID
ALIPAY_APP_ID=
# 应用私钥（PKCS1/PKCS8 PEM，可含 \n 转义的一行）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（验签异步通知）
ALIPAY_PUBLIC_KEY=
# 网关，默认 https://openapi.alipay.com/gateway.do；沙箱用 https://openapi.alipaydev.com/gateway.do
# ALIPAY_GATEWAY=

# 外网访问根 URL（用于支付宝 notify_url / return_url），生产环境须为 https://你的域名:8848 或反代后的 https 域名
# PUBLIC_BASE_URL=https://your-domain.com

# 私钥格式：密钥工具若生成 PKCS8，保持默认即可；若为 PKCS1 则设 ALIPAY_KEY_TYPE=PKCS1
# ALIPAY_KEY_TYPE=PKCS8

# 置于 Nginx/反代后时，若 req.protocol 需识别为 https，可设 TRUST_PROXY=1
# TRUST_PROXY=1

# 数据目录（可选）
# STUDIO_SERVER_DATA_DIR=/var/lib/plantuml-studio-server
